PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_db?schema=public"

# For SQLite zero-config local development, you can use:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="crm_jwt_super_secret_production_key_2026"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="http://localhost:5173"

# WhatsApp Business Cloud API Configuration
WHATSAPP_VERIFY_TOKEN="crm_wa_verify_token_secure_xyz"
WHATSAPP_API_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_API_VERSION="v21.0"

# Inbound & Outbound Email (SMTP / IMAP / Webhook)
EMAIL_INBOUND_ENABLED=true
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="support@example.com"
IMAP_PASSWORD="app_password"
IMAP_POLL_INTERVAL_MS=60000

SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mailtrap_user"
SMTP_PASS="mailtrap_pass"
SMTP_FROM="IT Support Desk <support@example.com>"

# AI Classification (Google Gemini API - Optional fallback to internal NLP engine)
GEMINI_API_KEY=""

