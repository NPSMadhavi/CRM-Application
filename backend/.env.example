PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_application?schema=public"

# JWT Authentication
JWT_SECRET="crm_jwt_super_secret_production_key_2026"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="http://localhost:5173"

# WhatsApp Business Cloud API Configuration
WHATSAPP_VERIFY_TOKEN="crm_wa_verify_token_secure_xyz"
WHATSAPP_API_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_API_VERSION="v21.0"

# Gmail SMTP Configuration
EMAIL_INBOUND_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"

SMTP_FROM_EMAIL="your_email@gmail.com"
SMTP_FROM_NAME="Enterprise CRM Support"
SMTP_FROM="Enterprise CRM Support <your_email@gmail.com>"
SUPPORT_EMAIL="your_email@gmail.com"

# Gmail IMAP Configuration
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="your_email@gmail.com"
IMAP_PASSWORD="your_gmail_app_password"
IMAP_TLS=true

# Storage
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# AI Classification (Google Gemini API - Optional fallback to internal NLP engine)
GEMINI_API_KEY=""
