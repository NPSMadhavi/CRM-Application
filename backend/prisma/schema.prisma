generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String
  fullName      String
  role          UserRole         @default(AGENT)
  department    String?          @default("IT Support")
  avatarUrl     String?
  phone         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  notifications Notification[]
  tickets       Ticket[]         @relation("AssignedTickets")
  auditLogs     TicketAuditLog[]
  notes         TicketNote[]
}

model Customer {
  id                 String         @id @default(uuid())
  name               String
  email              String?        @unique
  phone              String?        @unique
  company            String?
  isVip              Boolean        @default(false)
  avatarUrl          String?
  notes              String?
  sourceChannel      Channel        @default(EMAIL)
  supportPlanType    String         @default("ADHOC_4H")
  supportPlanName    String         @default("Ad-hoc 4-Hour Pack")
  allocatedHours     Float          @default(4.0)
  usedHours          Float          @default(0.0)
  hourlyRate         Float          @default(85.0)
  workingHoursWindow String         @default("MON_FRI_9AM_6PM")
  planStatus         String         @default("ACTIVE")
  planRenewalDate    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tickets            Ticket[]
  emailMessages      EmailMessage[]

  @@index([email])
  @@index([phone])
}

model Ticket {
  id               String           @id @default(uuid())
  ticketNumber     String           @unique
  title            String
  description      String
  status           TicketStatus     @default(NEW)
  priority         TicketPriority   @default(MEDIUM)
  category         TicketCategory   @default(GENERAL_INQUIRY)
  channel          Channel          @default(EMAIL)
  sourceIdentifier String?
  aiExtracted      Boolean          @default(false)
  aiConfidence     Float?           @default(0.0)
  aiSummary        String?
  sentiment        Sentiment        @default(CALM)
  customerId       String
  assignedToId     String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  firstResponseAt  DateTime?
  slaBreached      Boolean          @default(false)
  slaResponseDue   DateTime?
  slaResolutionDue DateTime?
  totalTimeHours   Float            @default(0.0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  notifications    Notification[]
  assignedTo       User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  auditLogs        TicketAuditLog[]
  messages         TicketMessage[]
  notes            TicketNote[]
  workLogs         TicketWorkLog[]
  emailMessages    EmailMessage[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([channel])
  @@index([assignedToId])
  @@index([customerId])
}

model TicketWorkLog {
  id            String   @id @default(uuid())
  ticketId      String
  agentId       String?
  agentName     String
  durationHours Float    @default(0.5)
  description   String
  isBillable    Boolean  @default(true)
  createdAt     DateTime @default(now())
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportPlanConfig {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?
  hoursIncluded      Float    @default(4.0)
  hourlyRate         Float    @default(85.0)
  monthlyPrice       Float    @default(340.0)
  workingHoursWindow String   @default("MON_FRI_9AM_6PM")
  slaResponseHours   Int      @default(4)
  slaResolutionHours Int      @default(24)
  isAdhoc            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TicketMessage {
  id                String        @id @default(uuid())
  ticketId          String
  senderType        SenderType    @default(CUSTOMER)
  senderName        String
  senderEmail       String?
  senderPhone       String?
  channel           Channel       @default(EMAIL)
  body              String
  externalMessageId String?       @unique
  attachments       String?
  createdAt         DateTime      @default(now())
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  emailRecord       EmailMessage?

  @@index([ticketId])
  @@index([externalMessageId])
}

model TicketNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketAuditLog {
  id           String   @id @default(uuid())
  ticketId     String
  actorId      String?
  actorName    String
  action       String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  details      String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model CategoryConfig {
  id                 String         @id @default(uuid())
  category           TicketCategory @unique
  name               String
  description        String?
  slaResponseHours   Int            @default(4)
  slaResolutionHours Int            @default(24)
  defaultPriority    TicketPriority @default(MEDIUM)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String?
  ticketId    String?
  title       String
  message     String
  type        String
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User?     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  ticket      Ticket?   @relation(fields: [ticketId], references: [id])

  @@index([recipientId])
  @@index([ticketId])
  @@index([isRead])
  @@index([createdAt])
}

model WebhookLog {
  id           String   @id @default(uuid())
  channel      Channel
  eventType    String
  payload      String
  status       String
  ticketId     String?
  errorMessage String?
  createdAt    DateTime @default(now())
}

model Integration {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("EMAIL")
  status    String   @default("CONNECTED")
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailMessage {
  id                String         @id @default(uuid())
  ticketMessageId   String?        @unique
  ticketMessage     TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  ticketId          String?
  ticket            Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  senderEmail       String         @default("")
  recipientEmail    String         @default("")
  fromAddress       String         @default("")
  toAddress         String         @default("")
  ccAddress         String?
  bccAddress        String?
  subject           String
  bodyHtml          String?
  bodyText          String?
  messageId         String?        @unique
  providerMessageId String?        @unique
  inReplyTo         String?
  references        String?
  direction         String         @default("INBOUND") // INBOUND, OUTBOUND
  status            String         @default("PENDING") // PENDING, SENT, FAILED, RECEIVED
  failureReason     String?
  errorMessage      String?
  retryCount        Int            @default(0)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ticketId])
  @@index([messageId])
  @@index([providerMessageId])
  @@index([inReplyTo])
  @@index([direction])
  @@index([status])
}

enum UserRole {
  ADMIN
  TIER_1_AGENT
  TIER_2_AGENT
  AGENT
}

enum TicketStatus {
  NEW
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCOUNT_ACCESS
  BILLING
  GENERAL_INQUIRY
}

enum Channel {
  WHATSAPP
  EMAIL
  PORTAL
}

enum Sentiment {
  CALM
  FRUSTRATED
  ANGRY
  URGENT
}

enum SenderType {
  CUSTOMER
  AGENT
  SYSTEM
}
